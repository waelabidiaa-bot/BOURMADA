// =================================
// 1. UNDEFINED VARIABLES
// =================================

print(unknown)
x = 10


// =================================
// 2. DIVISION BY ZERO
// =================================

print(10 / 0)


// =================================
// 3. TYPE MISMATCH
// =================================

let int age = "hello"
let str name = 123
let bool active = 10


// =================================
// 4. INVALID OPERATIONS
// =================================

print("hello" - 5)
print("hello" * 3)
print(true + 10)


// =================================
// 5. INVALID CONDITIONS
// =================================

if (10 + "hello") {
    print("Invalid")
}


// =================================
// 6. BREAK OUTSIDE A LOOP
// =================================

break


// =================================
// 7. RETURN OUTSIDE A FUNCTION
// =================================

return 10


// =================================
// 8. WRONG FUNCTION ARGUMENTS
// =================================

fn int add(int a, int b) {
    return a + b
}

print(add(5))
print(add(5, 10, 15))


// =================================
// 9. WRONG RETURN TYPE
// =================================

fn int getName() {
    return "Wael"
}


// =================================
// 10. DUPLICATE VARIABLES
// =================================

let int x = 10
let int x = 20


// =================================
// 11. INVALID SYNTAX
// =================================

let int = 10

if (x > 5 {
    print(x)
}

while (x < 10) {
    x = x + 1
}