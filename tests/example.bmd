table users{
    str name
    int age
    bool active
}
insert users{
    name:"Alice",
    age:30,
    active:true
}
insert users{
    name:"Bob",
    age:25,
    active:false
}
insert users{
    name:"Charlie",
    age:35,
    active:true
}

for(int i;i<3) do{
    print("name: ")
    print(users[i].name)
    print("age: ")
    print(users[i].age)
    print("active: ")
    print(users[i].active)
    print("--------------")
}